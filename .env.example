# Generate actual secret files with: python tools/compose_init.py
# This file contains no passwords or tokens.
POSEGOOD_PROJECT_NAME=posegood
POSEGOOD_BIND_ADDRESS=127.0.0.1
POSEGOOD_HTTP_PORT=8080
POSEGOOD_COOKIE_SECURE=false
# Another-origin frontend (e.g. https://app.posegood.site): exact origins, comma-separated, no trailing /, no *. Empty = same origin only.
POSEGOOD_CORS_ALLOWED_ORIGINS=
POSEGOOD_REALTIME_ALLOWED_ORIGINS=
POSEGOOD_SECRETS_DIR=./.cache/compose/secrets
