{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posegood.local/contracts/posture-observation.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "start_ms",
    "end_ms",
    "phase",
    "valid",
    "collapse_probability",
    "deviation_type",
    "model_version"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "end_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "phase": {
      "enum": [
        "running",
        "rest",
        "away"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "collapse_probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "deviation_type": {
      "enum": [
        "none",
        "forward_slouch",
        "left_lean",
        "right_lean",
        "unspecified"
      ]
    },
    "model_version": {
      "type": "string",
      "pattern": "^[a-z0-9._-]{1,64}$"
    }
  }
}
