{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posegood.local/contracts/posture-event.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "event_id",
    "kind",
    "timestamp_ms",
    "onset_ms",
    "onset_valid_ms",
    "deviation_type",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_id": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "collapse_confirmed",
        "recovery_confirmed",
        "reminder",
        "interrupted",
        "session_ended"
      ]
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0
    },
    "onset_ms": {
      "type": "integer",
      "minimum": 0
    },
    "onset_valid_ms": {
      "type": "integer",
      "minimum": 0
    },
    "deviation_type": {
      "enum": [
        "none",
        "forward_slouch",
        "left_lean",
        "right_lean",
        "unspecified"
      ]
    },
    "reason": {
      "enum": [
        null,
        "missing",
        "missing_sequence",
        "unmeasurable",
        "rest",
        "away",
        "ended"
      ]
    }
  }
}
