{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posegood.local/contracts/inference-request.schema.json",
  "title": "Nine-keypoint frame inference request v3",
  "description": "Consumers also enforce 0 < end_ms - start_ms <= 1500, finite numbers and valid baseline geometry.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_version",
    "baseline_id",
    "sequence",
    "start_ms",
    "end_ms",
    "phase",
    "frames",
    "baseline"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "feature_version": {
      "const": "keypoints-9-v1"
    },
    "baseline_id": {
      "description": "Random UUID for the camera calibration, never a participant identifier.",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "end_ms": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "phase": {
      "enum": ["running", "rest", "away"]
    },
    "frames": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "anyOf": [
          { "type": "null" },
          { "$ref": "#/$defs/frame" }
        ]
      }
    },
    "baseline": {
      "description": "Nine averaged baseline [x, y] points in the same joint order as the frames, without visibility.",
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/baseline_point" }
    }
  },
  "$defs": {
    "frame": {
      "description": "MediaPipe joints 0, 2, 5, 7, 8, 9, 10, 11, 12 in that order: nose, left eye, right eye, left ear, right ear, left mouth corner, right mouth corner, left shoulder, right shoulder.",
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/joint" }
    },
    "joint": {
      "description": "[x, y, visibility]",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1, "maximum": 2 },
        { "type": "number", "minimum": -1, "maximum": 2 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "items": false,
      "minItems": 3
    },
    "baseline_point": {
      "description": "[x, y]",
      "type": "array",
      "items": { "type": "number", "minimum": 0, "maximum": 1 },
      "minItems": 2,
      "maxItems": 2
    }
  }
}
