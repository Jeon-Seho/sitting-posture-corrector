{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic-first posture status contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp_ms", "status", "deviation_type", "confidence", "measurement_quality", "duration_ms"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "timestamp_ms": {"type": "integer", "minimum": 0},
    "status": {"enum": ["normal", "deviation", "unmeasurable"]},
    "deviation_type": {"enum": [null, "forward_slouch", "left_lean", "right_lean"]},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "measurement_quality": {"enum": ["good", "poor"]},
    "duration_ms": {"type": "integer", "minimum": 0}
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "normal"},
        "deviation_type": {"type": "null"},
        "confidence": {"type": "number"},
        "measurement_quality": {"const": "good"},
        "duration_ms": {"const": 0}
      }
    },
    {
      "properties": {
        "status": {"const": "deviation"},
        "deviation_type": {"type": "string"},
        "confidence": {"type": "number"},
        "measurement_quality": {"const": "good"}
      }
    },
    {
      "properties": {
        "status": {"const": "unmeasurable"},
        "deviation_type": {"type": "null"},
        "confidence": {"type": "null"},
        "measurement_quality": {"const": "poor"},
        "duration_ms": {"const": 0}
      }
    }
  ]
}
