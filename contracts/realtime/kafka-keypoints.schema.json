{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posegood.local/contracts/realtime/kafka-keypoints.schema.json",
  "title": "Topic posture.keypoints: single-frame coordinate archive",
  "description": "Archive-only normalized single-frame intervals. Failed archive publication does not stop measurement. J1 stores the original messages in keypoints.jsonl.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "session_id",
    "user_id",
    "produced_at",
    "kind",
    "body"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "const": "keypoints"
    },
    "body": {
      "$ref": "frames/posture-frame.schema.json"
    }
  }
}
