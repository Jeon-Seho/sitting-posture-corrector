{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posegood.local/contracts/realtime/kafka-features.v1.schema.json",
  "title": "Topic posture.features.v1 (draft): entry API -> inference",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "message_id", "session_id", "user_id", "produced_at", "kind", "body"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "message_id": { "type": "string", "format": "uuid" },
    "session_id": { "type": "string", "format": "uuid" },
    "user_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "produced_at": { "type": "string", "format": "date-time" },
    "kind": { "enum": ["session_started", "features", "session_ended"] },
    "body": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "session_started" } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/session_started" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "features" } } },
      "then": { "properties": { "body": { "$ref": "../inference-request.v2.schema.json" } } }
    },
    {
      "if": { "properties": { "kind": { "const": "session_ended" } } },
      "then": { "properties": { "body": { "$ref": "#/$defs/session_ended" } } }
    }
  ],
  "$defs": {
    "session_started": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "baseline_id", "frame"],
      "properties": {
        "policy": { "$ref": "../session-view.v1.schema.json#/properties/policy" },
        "baseline_id": { "type": "string", "format": "uuid" },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "height": { "type": "integer", "minimum": 1, "maximum": 16384 }
          }
        }
      }
    },
    "session_ended": {
      "type": "object",
      "additionalProperties": false,
      "required": ["end_ms"],
      "properties": {
        "end_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 }
      }
    }
  }
}
