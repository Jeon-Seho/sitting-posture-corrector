{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posegood.local/contracts/realtime/frames/posture-frames.v1.schema.json",
  "title": "posture.frames.v1 — 0.5 s of raw 9-joint coordinate frames from the app (FE draft 2026-10-13)",
  "description": "FE proposal 2.1. One message per interval [start_ms, end_ms), times relative to the session start. Frames are not averaged. rest/away intervals carry no frames. valid:false marks a frame whose user position the app could not determine (10/12 meeting); the field name awaits BE confirmation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature_version", "sequence", "start_ms", "end_ms", "phase", "width", "height", "frames"],
  "properties": {
    "schema_version": { "const": "3.0" },
    "feature_version": { "const": "keypoints-9-v1" },
    "sequence": { "type": "integer", "minimum": 0 },
    "start_ms": { "type": "integer", "minimum": 0 },
    "end_ms": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["running", "calibration", "rest", "away"] },
    "width": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "height": { "type": "integer", "minimum": 0, "maximum": 4096 },
    "frames": {
      "type": "array",
      "maxItems": 30,
      "items": { "$ref": "#/$defs/frame" }
    }
  },
  "$defs": {
    "joint": {
      "description": "[x, y, visibility]; x and y are 0-1 ratios of the frame (5 decimals), y grows downward, not mirrored.",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -1, "maximum": 2 },
        { "type": "number", "minimum": -1, "maximum": 2 },
        { "type": "number", "minimum": 0, "maximum": 1 }
      ],
      "items": false,
      "minItems": 3
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["t_ms", "p"],
      "properties": {
        "t_ms": { "type": "integer", "minimum": 0 },
        "p": {
          "description": "MediaPipe joints 0, 2, 5, 7, 8, 9, 10, 11, 12 in that order; null when nobody was tracked.",
          "oneOf": [
            { "type": "null" },
            { "type": "array", "items": { "$ref": "#/$defs/joint" }, "minItems": 9, "maxItems": 9 }
          ]
        },
        "valid": { "const": false }
      }
    }
  }
}
