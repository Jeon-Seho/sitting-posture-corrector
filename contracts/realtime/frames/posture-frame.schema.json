{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posegood.local/contracts/realtime/frames/posture-frame.schema.json",
  "title": "Single coordinate frame interval",
  "description": "Versionless flat body. The receiver checks 1..1500 ms interval length and captured t_ms in [start_ms,end_ms). No observation uses unmeasurable, p null and no t_ms.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "start_ms", "end_ms", "phase"],
  "properties": {
    "sequence": {"type": "integer", "minimum": 0},
    "start_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
    "end_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
    "phase": {"enum": ["running", "unmeasurable", "rest", "away"]},
    "t_ms": {"type": "integer", "minimum": 0},
    "p": {
      "oneOf": [
        {"type": "null"},
        {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/joint"}}
      ]
    }
  },
  "allOf": [
    {"if": {"properties": {"phase": {"const": "running"}}}, "then": {"required": ["t_ms", "p"], "properties": {"p": {"type": "array"}}}},
    {"if": {"properties": {"phase": {"const": "unmeasurable"}}}, "then": {"required": ["p"], "properties": {"p": {"const": null}}}},
    {"if": {"properties": {"phase": {"enum": ["rest", "away"]}}}, "then": {"not": {"anyOf": [{"required": ["t_ms"]}, {"required": ["p"]}]}}}
  ],
  "$defs": {
    "joint": {
      "type": "array",
      "minItems": 3,
      "prefixItems": [
        {"type": "number", "minimum": -1, "maximum": 2},
        {"type": "number", "minimum": -1, "maximum": 2},
        {"type": "number", "minimum": 0, "maximum": 1}
      ],
      "items": false
    }
  }
}
