{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://posegood.local/contracts/realtime/kafka-episodes.v1.schema.json",
  "title": "Topic posture.episodes.v1 (draft): decision (state machine) -> gateway (per-interval observation, events and periodic progress)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "message_id",
    "session_id",
    "user_id",
    "produced_at",
    "kind",
    "body"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "session_id": {
      "type": "string",
      "format": "uuid"
    },
    "user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "enum": [
        "observation",
        "decision",
        "progress"
      ]
    },
    "body": {
      "type": "object"
    }
  },
  "$defs": {
    "observation": {
      "description": "(D-57) Every judged interval, in input order before its decisions: what the app shows live (realtime-ws.v2 observation 4.0). Same rules as the API engine (SessionEngine.live): invalid intervals have posture and score null and both times 0; recovery_ms counts only while an episode is open.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "start_ms",
        "end_ms",
        "phase",
        "valid",
        "posture",
        "collapse_probability",
        "hold_ms",
        "recovery_ms"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400000
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "phase": {
          "enum": [
            "running",
            "rest",
            "away"
          ]
        },
        "valid": {
          "type": "boolean"
        },
        "posture": {
          "enum": [
            "good",
            "bad",
            null
          ]
        },
        "collapse_probability": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "hold_ms": {
          "type": "integer",
          "minimum": 0
        },
        "recovery_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_sequence",
        "event",
        "summary"
      ],
      "properties": {
        "last_sequence": {
          "type": "integer",
          "minimum": -1
        },
        "event": {
          "$ref": "../posture-event.v1.schema.json"
        },
        "summary": {
          "$ref": "../session-view.v1.schema.json#/properties/summary"
        }
      }
    },
    "progress": {
      "description": "Periodic (about 1 s) decision state: everything up to last_sequence is counted in summary.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "last_sequence",
        "summary"
      ],
      "properties": {
        "last_sequence": {
          "type": "integer",
          "minimum": -1
        },
        "summary": {
          "$ref": "../session-view.v1.schema.json#/properties/summary"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "observation"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/observation"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "decision"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/decision"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "progress"
          }
        }
      },
      "then": {
        "properties": {
          "body": {
            "$ref": "#/$defs/progress"
          }
        }
      }
    }
  ]
}
