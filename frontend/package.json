{
  "name": "posegood-frontend",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "desktop:dev": "electron electron/main.cjs",
    "desktop": "node electron/launch-dev.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run test && npm run build && npm run lab:build && npm run face:build",
    "lab:dev": "vite --mode relative-lab --host 127.0.0.1 --port 5185",
    "lab:desktop": "node electron/launch-lab.mjs",
    "lab:build": "npm run assets && tsc -b && vite build --mode relative-lab --outDir dist-lab",
    "lab:pack": "node scripts/check-lab-model.mjs && npm run lab:build && electron-builder --config lab-builder.json --win portable",
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "desktop:pack": "npm run build && electron-builder --win --dir && node scripts/copy-desktop.mjs",
    "desktop:portable": "npm run build && electron-builder --win portable",
    "face:assets": "node scripts/prepare-face-assets.mjs && node scripts/build-face-worker.mjs",
    "face:dev": "npm run assets && npm run face:assets && vite --mode face-lab --host 127.0.0.1 --port 5186",
    "face:desktop": "node electron/launch-face.mjs",
    "face:build": "npm run assets && npm run face:assets && tsc -b && vite build --mode face-lab --outDir dist-face",
    "face:pack": "node scripts/check-face-model.mjs && npm run face:build && electron-builder --config face-builder.json --win portable"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@phosphor-icons/react": "^2.1.10",
    "pretendard": "^1.3.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-test-renderer": "18.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "react-test-renderer": "18.3.1",
    "rolldown": "1.2.9",
    "typescript": "^5.6.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "main": "electron/main.cjs",
  "description": "PoseGood 바른자세 도우미",
  "author": "PoseGood team",
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.posegood.desktop",
    "productName": "PoseGood",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/branding/posegood-icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "PoseGood.exe"
    }
  }
}
