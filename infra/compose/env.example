# 빅데이터 플랫폼 compose(infra/compose/bigdata.yaml)용 — 이 파일을 같은 폴더에 .env로 복사해 값을 채운다.
#   cp infra/compose/env.example infra/compose/.env
# .env는 저장소에 커밋하지 않는다(infra/compose/.gitignore). 이 파일(env.example)에는 실제 비밀번호를 쓰지 않는다.
# 저장소 루트의 .env.example은 팀 compose.yaml용으로 다른 파일이다.
#
# (D-24) 실행 환경(서버 PC·다른 PC)마다 달라지는 값은 모두 여기서 정한다.
#   [필수]  값이 없으면 compose가 시작하지 않고(SERVER_LAN_IP·SERVICE_DB_SCHEMA) 통합 테스트 0단계도 FAIL이다.
#   [선택]  비워 두거나 지우면 괄호 안의 기본값을 쓴다.
# .env에 두지 않는 것(compose에 고정): 메모리 상한(mem_limit·KAFKA_HEAP_OPTS·Redis maxmemory), 127.0.0.1 바인딩 자체,
#   DataNode 9864 번호, 컨테이너끼리 쓰는 이름·포트(kafka:19092·redis:6379·inference:8092), 토픽·파티션, TZ(KST).
# 값 뒤에 주석을 붙이지 않는다(값의 일부가 된다). 파일 끝에는 줄바꿈을 둔다 — 덧붙일 때 앞 줄에 붙지 않게.

# ---------------------------------------------------------------------
# 1. 서버 주소 [필수]
# ---------------------------------------------------------------------
# 서버 PC의 LAN IP. Kafka EXTERNAL 광고 주소(GPU PC가 접속하는 주소)와 9094·9870·9864 바인딩에 쓴다.
SERVER_LAN_IP=192.168.0.104
# 외부 GPU PC(추론 이전 대상) IP — 참고 값. compose는 쓰지 않고, 방화벽(DOCKER-USER) 규칙과 안내에 쓴다.
GPU_PC_IP=192.168.0.108

# ---------------------------------------------------------------------
# 2. 외부 MySQL [필수] — DB 담당 PC. localhost나 VirtualBox Host-only IP는 쓰지 않는다(컨테이너 자신을 가리킴).
# ---------------------------------------------------------------------
DB_HOST=192.168.0.107
DB_PORT=3306
# 판정 서비스(api-server)의 기존 경로가 쓰는 테스트용 스키마
DB_NAME=posture_app
DB_USER=posture_app
DB_PASSWORD=changeme
# 확정 서비스 DB(V2.3) 이름 — 판정 결과 저장(api-server)과 입출구 서버(io-api)가 함께 쓴다
SERVICE_DB_SCHEMA=posture_service

# ---------------------------------------------------------------------
# 3. 바깥 포트·바인딩 [선택] — 서버 PC의 다른 프로그램과 겹칠 때만 바꾼다
# ---------------------------------------------------------------------
# api-server(판정·운영 API) — 지금은 LAN 공개(포트 정리는 D-43)
API_SERVER_BIND=0.0.0.0
API_SERVER_HOST_PORT=8080
# inference-service(서버 PC 추론 사본)
INFERENCE_BIND=0.0.0.0
INFERENCE_HOST_PORT=8000
# 서버 PC 안(127.0.0.1)에서만 여는 포트
KAFKA_HOST_PORT=9092
REDIS_HOST_PORT=6379
HDFS_RPC_HOST_PORT=9000
SPARK_UI_HOST_PORT=4040
# SERVER_LAN_IP에 여는 포트(GPU PC 전용, DOCKER-USER로 소스 IP 제한). Kafka는 광고 포트도 이 값이 된다
KAFKA_EXTERNAL_PORT=9094
HDFS_NAMENODE_UI_PORT=9870

# ---------------------------------------------------------------------
# 4. 이미지 [선택] — 버전 태그 고정(latest 금지). 올릴 때는 여기서 바꾸고 통합 테스트
# ---------------------------------------------------------------------
KAFKA_IMAGE=apache/kafka:4.3.1
SPARK_IMAGE=apache/spark:4.2.0
REDIS_IMAGE=redis:7.4.11-alpine

# ---------------------------------------------------------------------
# 5. 처리 서비스(api-server) [선택] — 값을 바꿀 때만
# ---------------------------------------------------------------------
# (D-53) v1 판정기(judge) — 세션 시작 메시지에 정책이 없을 때의 기본값, 입력이 끊긴 세션을 닫는 시간
JUDGE_HOLD_SECONDS=3
JUDGE_RECOVERY_SECONDS=3
JUDGE_REMINDER_SECONDS=60
JUDGE_THRESHOLD=0.7
JUDGE_SESSION_TIMEOUT_SECONDS=300
# 옛 posture.summary 경로(cep) 판정 파라미터 — D-38에서 옛 경로와 함께 지운다
CEP_PERSIST_SECONDS=3
CEP_RECOVERY_SECONDS=3
CEP_REALERT_SECONDS=60
CEP_SESSION_TIMEOUT_SECONDS=300
CEP_SESSION_EXPIRY_INTERVAL_SECONDS=60
# (D-51) 기본 판정 정책 값 4개 — 입출구 서버(posegood.default-policy.*)·seed_04와 같아야 한다
SERVICE_DB_DEFAULT_THRESHOLD=0.7
SERVICE_DB_DEFAULT_HOLD_SECONDS=3
SERVICE_DB_DEFAULT_RECOVER_SECONDS=3
SERVICE_DB_DEFAULT_REALERT_SECONDS=60
# (D-30) 시험용 계정·세션 행 API — 시험 서버에서만 true(통합 테스트 11단계)
REPORT_TEST_FIXTURES_ENABLED=false

# ---------------------------------------------------------------------
# 6. 입출구 서버(io-api, compose --profile io) [선택]
# ---------------------------------------------------------------------
# 127.0.0.1이면 서버 PC 안에서만. 앱·FE가 LAN에서 붙을 때 0.0.0.0(포트 정리는 D-43)
IO_API_BIND=127.0.0.1
IO_API_HOST_PORT=8090
# 위 DB_USER·DB_PASSWORD·SERVICE_DB_SCHEMA와 다른 계정·DB를 쓸 때만 주석을 풀어 채운다
# IO_DB_USER=
# IO_DB_PASSWORD=
# IO_DB_NAME=
# 로그인 쿠키 Secure(HTTPS 뒤에서만 true), 실시간 연결을 허용할 출처(쉼표로 구분)
POSEGOOD_COOKIE_SECURE=false
POSEGOOD_REALTIME_ALLOWED_ORIGINS=
# (D-57) 실시간 판정 경로: local = API 안 판정(지금), kafka = ws → Kafka → 처리 서비스(계획 0031 1단계 코드가 들어간 뒤).
# Kafka·Redis 주소는 compose가 컨테이너 안 이름(kafka:19092·redis)으로 넣는다.
POSEGOOD_REALTIME_PIPELINE=local
